generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Supabase project's Postgres database. DATABASE_URL should be the pooled
// ("Transaction" mode / port 6543) connection string for the app at runtime;
// DIRECT_URL should be the direct ("Session" mode / port 5432) connection,
// which Prisma needs for migrations since PgBouncer pooling doesn't support
// the prepared statements `prisma migrate` relies on. Both are on Supabase's
// Project Settings -> Database page.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A dashboard user directory (distinct from Account, which stores login
// credentials the agent uses against a TARGET application). Passwords are
// hashed (scrypt) and never returned by the API.
//
// Login is gated by the AUTH_ENABLED env var (off by default). When on,
// login is validated by email + password. A user's first successful
// password check doesn't log them in yet — it issues a one-time
// verification code to their email (proving they own the mailbox); once
// verified, every later login is just email + password.
//
// roleId is optional: a user with no role keeps full, unrestricted access
// (so assigning roles is a purely additive restriction — nothing breaks for
// existing users). Once assigned, a role limits which dashboard pages
// (Role.allowedPagesJson) that user can see.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String?
  email        String   @unique
  passwordHash String
  roleId       String?
  role         Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emailVerifiedAt           DateTime?
  verificationCodeHash      String?
  verificationCodeExpiresAt DateTime?
  verificationAttempts      Int       @default(0)
}

// A role master: a named set of dashboard pages a user may see (e.g.
// "QA Tester" -> only Reports + Projects). Page keys are validated against
// a fixed list in server/src/access/pages.ts, matching the app's own nav.
model Role {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  allowedPagesJson String // JSON-encoded array of page keys
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users User[]
}

// The top-level "project master" — an application/product under test.
// Test cases across all of a project's test runs are consolidated under it
// for dashboard reporting, broken down by the project's defined modules.
model Project {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  modules   ProjectModule[]
  accounts  Account[]
  testRuns  TestRun[]
  testFlows TestFlow[]
}

// A named module within a project's master module list (e.g. "Login",
// "Checkout", "Reporting"). Reference data for organizing/reporting on a
// project — not directly tied to the pages the crawler discovers per run.
model ProjectModule {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())

  @@unique([projectId, name])
}

// A login account the agent can use against a target application.
// NOTE: credentials are stored in plaintext for this MVP because the agent
// needs to actively re-type them into login forms during a run. Do not seed
// this table with real production credentials — use dedicated test accounts.
model Account {
  id        String   @id @default(cuid())
  label     String
  targetUrl String
  username  String
  password  String
  role      String? // e.g. "admin", "standard-user", "read-only"
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  testRuns  TestRun[]
  testFlows TestFlow[]
}

model TestRun {
  id          String    @id @default(cuid())
  targetUrl   String
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  mode        String    @default("full") // full | quick (only re-run cases that failed last time, plus smoke)
  status      String    @default("pending") // pending | crawling | generating | executing | completed | failed
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  reportPath  String?
  regressionsJson String? // JSON-encoded diff vs the previous run for this target (regressed/fixed case names)
  enabledCategoriesJson String? // JSON-encoded array of TestCategory keys the user selected via checkboxes; null = all categories
  createdByUsername String? // snapshot of the platform user's display name/username who started this run (AUTH_ENABLED sessions only)
  moduleName  String?   // tester-entered business module name for this run (e.g. "Payroll"), required at the API level; identifies the module independent of whatever titles the crawler finds on the page
  testStories String? // freeform custom test stories typed on the New Test Run page for this module, persisted so a later run of the same module can offer to reuse them

  // rollup counters, updated as the run progresses
  totalCases  Int @default(0)
  passedCases Int @default(0)
  failedCases Int @default(0)
  errorCases  Int @default(0)

  modules    Module[]
  testCases  TestCase[]
  usageEvents UsageEvent[]
}

// A discovered page/form/element cluster on the target application, found by
// the crawler purely to drive field-based test generation (smoke, boundary,
// vulnerability, etc.) — not a unit the tester names or attaches stories to
// directly (see TestRun.moduleName/testStories for that).
model Module {
  id         String  @id @default(cuid())
  testRunId  String
  testRun    TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  name       String
  url        String
  type       String // page | form | nav
  fieldsJson String // JSON-encoded array of detected input fields (name, type, attrs)
  userStoriesJson String? // legacy: JSON-encoded per-page user stories from before TestRun.moduleName/testStories existed; unused going forward, kept for old runs' history

  testCases TestCase[]
}

model TestCase {
  id          String  @id @default(cuid())
  testRunId   String
  testRun     TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  moduleId    String?
  module      Module? @relation(fields: [moduleId], references: [id])
  testFlowId  String?
  testFlow    TestFlow? @relation(fields: [testFlowId], references: [id])
  category    String // smoke | boundary | vulnerability | loginBoundary | stress | performance | compatibility | accessibility | flow | story
  name        String
  description String
  inputJson   String? // JSON-encoded input(s) used for this case
  expectation String? // expected result this case checks for, shown alongside the actual/observed result
  testType    String  @default("positive") // positive (valid/expected input or normal usage) | negative (invalid/malicious input, expected to be rejected)

  result            TestResult?
  stressMetric      StressMetric?
  performanceMetric PerformanceMetric?
  flowStepResults   FlowStepResult[]
}

model TestResult {
  id          String   @id @default(cuid())
  testCaseId  String   @unique
  testCase    TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  status      String // pass | fail | error
  severity    String? // info | low | medium | high | critical (mainly for vulnerability cases)
  actual      String // observed behavior / evidence
  screenshotPath String?
  durationMs  Int
  createdAt   DateTime @default(now())
}

// Concurrent-load metrics for a "stress" category TestCase — either N
// concurrent GETs against a page or N concurrent submissions of a form.
model StressMetric {
  id            String   @id @default(cuid())
  testCaseId    String   @unique
  testCase      TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  concurrency   Int
  totalRequests Int
  errorCount    Int
  errorRatePct  Float
  avgLatencyMs  Int
  p95LatencyMs  Int
  createdAt     DateTime @default(now())
}

// Navigation-timing / page-weight metrics for a "performance" category TestCase.
model PerformanceMetric {
  id                   String   @id @default(cuid())
  testCaseId           String   @unique
  testCase             TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  domContentLoadedMs   Int
  loadEventMs          Int
  resourceCount        Int
  transferSizeKb       Int
  createdAt            DateTime @default(now())
}

// A user-authored, reusable multi-step journey (e.g. login -> add to cart ->
// checkout -> expect confirmation), used to cover integration/system/
// functional/UAT-style testing that can't be inferred from crawling alone.
model TestFlow {
  id        String   @id @default(cuid())
  label     String
  targetUrl String
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  steps     FlowStep[]
  testCases TestCase[]
}

model FlowStep {
  id         String   @id @default(cuid())
  testFlowId String
  testFlow   TestFlow @relation(fields: [testFlowId], references: [id], onDelete: Cascade)
  order      Int
  action     String // navigate | fill | click | expectUrlContains | expectTextContains | expectElementVisible
  selector   String?
  value      String?
}

model FlowStepResult {
  id             String   @id @default(cuid())
  testCaseId     String
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  order          Int
  action         String
  status         String // pass | fail | error
  detail         String
  screenshotPath String?
  durationMs     Int
  createdAt      DateTime @default(now())
}

// Fine-grained usage/behavior events captured while the agent drives the
// target app, used to compute application usage KPIs (response times, errors).
model UsageEvent {
  id           String   @id @default(cuid())
  testRunId    String
  testRun      TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  url          String
  method       String   @default("GET")
  statusCode   Int?
  responseMs   Int?
  consoleError String?
  createdAt    DateTime @default(now())
}
