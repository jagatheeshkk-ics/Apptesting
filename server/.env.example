# Supabase Postgres connection strings — from your Supabase project's
# Project Settings -> Database page. DATABASE_URL is the pooled connection
# (port 6543, `pgbouncer=true`) used by the app at runtime; DIRECT_URL is the
# direct connection (port 5432) Prisma needs for running migrations.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

PORT=4000
# Optional: point at a pre-installed Chromium binary instead of the one
# Playwright would normally download (useful in sandboxed/offline environments).
# CHROMIUM_EXECUTABLE_PATH=/path/to/chromium

# Dashboard login — off by default. Set AUTH_ENABLED=true to require sign-in.
# AUTH_ENABLED=true
# AUTH_SECRET must be a long random string when AUTH_ENABLED=true (e.g. `openssl rand -hex 32`).
# AUTH_SECRET=

# Cross-origin API access. Leave unset when the dashboard is served from this
# same process (production) or through the Vite dev proxy — both are
# same-origin and need no CORS. Only set this (comma-separated origins) if a
# browser app on a different origin must call the API with credentials.
# CORS_ORIGINS=https://dashboard.example.com

# Optional: SMTP for verification emails. If unset, the verification code is
# logged to the server console instead, so you can test the flow first.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AppTesting Agent <no-reply@yourdomain.com>"

# Optional: AI-generated user stories on the New Test Run page. Free API
# key from https://aistudio.google.com/apikey. If unset, stories are still
# generated — just from simple templates instead of an LLM.
# GEMINI_API_KEY=
