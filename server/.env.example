# Supabase Postgres connection strings — from your Supabase project's
# Project Settings -> Database page. DATABASE_URL is the pooled connection
# (port 6543, `pgbouncer=true`, via the Supavisor pooler host) used by the
# app at runtime. DIRECT_URL is what `prisma db push`/`migrate` use to apply
# schema changes, and MUST be the true direct connection (db.[project-ref].
# supabase.co, port 5432) — not routed through the pooler. Schema changes
# applied through the pooler can silently fail to actually take effect even
# though the CLI reports success, leaving the database out of sync with
# what the app expects.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

PORT=4000
# Optional: point at a pre-installed Chromium binary instead of the one
# Playwright would normally download (useful in sandboxed/offline environments).
# CHROMIUM_EXECUTABLE_PATH=/path/to/chromium

# Optional: how many test cases run concurrently within a run (default 4).
# Lower it if the host is memory-constrained or the target app doesn't
# tolerate concurrent requests well; raise it for faster runs if the host
# has room.
# TEST_EXECUTION_CONCURRENCY=4

# Dashboard login — off by default. Set AUTH_ENABLED=true to require sign-in.
# AUTH_ENABLED=true
# AUTH_SECRET must be a long random string when AUTH_ENABLED=true (e.g. `openssl rand -hex 32`).
# AUTH_SECRET=

# Optional: SMTP for verification emails. If unset, the verification code is
# logged to the server console instead, so you can test the flow first.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AppTesting Agent <no-reply@yourdomain.com>"

# Optional: AI-generated user stories on the New Test Run page. Free API
# key from https://aistudio.google.com/apikey. If unset, stories are still
# generated — just from simple templates instead of an LLM.
# GEMINI_API_KEY=
