    "create-admin": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/static": "^7.0.4",
    "@google/genai": "^2.21.0",
    "@prisma/client": "^5.19.1",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "nodemailer": "^9.0.5",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^5.19.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "2.1.9"
  }
